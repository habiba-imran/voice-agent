# Deny by default, including private files not anticipated by a filename blacklist.
**
!Dockerfile
!pyproject.toml
!uv.lock
!.python-version
!agent.py
!prompt.md
!config.example.yaml
!customization/
!customization/agent.yaml
!customization/prompt.md
!src/
!src/voiceagent/
!src/voiceagent/*.py
!scripts/
!scripts/prepare_models.py
# Reassert private/compiled exclusions beneath explicitly included directories.
**/.env*
**/__pycache__/**
**/*.py[cod]
**/livekit*.toml
**/*.wav
**/*.mp3
**/*.pcm
**/*.ogg
**/*.flac
