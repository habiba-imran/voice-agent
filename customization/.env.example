# Copy to customization/.env.local locally. Never commit the private file.
# Process environment > this file > legacy root .env.local > YAML > defaults.
VOICEAGENT_CONFIG_PATH=customization/agent.yaml
VOICEAGENT_PROMPT_PATH=customization/prompt.md
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
VOICEAGENT_TTS__VOICE_ID=
# Cloud injects LIVEKIT_*: do not upload them as Cloud secrets.
# For a customized Cloud worker, set the two nonsecret path variables above explicitly.
