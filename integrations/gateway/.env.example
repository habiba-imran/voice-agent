# Separate server environment. Never expose these in browser/NEXT_PUBLIC variables.
# This reference is LiveKit Cloud-only: strict RemoveParticipant token revocation is required.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_GATEWAY_ASSERTION_SECRET=
VOICE_GATEWAY_DATABASE=/var/lib/voice-gateway/limits.sqlite3
VOICE_GATEWAY_WEB_ORIGIN=https://example.invalid
VOICE_GATEWAY_AGENT_NAME=voiceagent
# Atomic reservations charge the verified worker maximum, not the shorter UI duration.
# Verify these against your deployed worker before enabling real traffic.
VOICE_GATEWAY_WORKER_HARD_SECONDS=1800
VOICE_GATEWAY_SESSION_SECONDS=300
VOICE_GATEWAY_TOKEN_SECONDS=60
VOICE_GATEWAY_GLOBAL_CONCURRENT=3
VOICE_GATEWAY_PRINCIPAL_CONCURRENT=1
VOICE_GATEWAY_GLOBAL_DAILY_SESSIONS=20
VOICE_GATEWAY_GLOBAL_DAILY_SECONDS=36000
VOICE_GATEWAY_PRINCIPAL_DAILY_SESSIONS=5
VOICE_GATEWAY_PRINCIPAL_DAILY_SECONDS=9000
