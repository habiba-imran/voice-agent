# Server-only variables. The browser receives only its short-lived scoped participant token.
VOICE_WEB_ORIGIN=https://example.invalid
VOICE_GATEWAY_URL=https://gateway.example.invalid
VOICE_GATEWAY_ASSERTION_SECRET=
# Same dedicated secret as the central gateway; never reuse a provider/LiveKit key.
